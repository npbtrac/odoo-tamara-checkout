<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_transaction_form" model="ir.ui.view">
        <field name="name">payment.transaction.form.inherit.tamara</field>
        <field name="model">payment.transaction</field>
        <field name="inherit_id" ref="payment.payment_transaction_form"/>
        <field name="arch" type="xml">
            <field name="provider_reference" position="after">
                <field name="tamara_order_id" invisible="provider_code != 'tamara'"/>
                <field name="tamara_order_status" invisible="provider_code != 'tamara'"/>
                <field name="tamara_payment_type" invisible="provider_code != 'tamara'"/>
                <field name="tamara_checkout_url" widget="url"
                       invisible="provider_code != 'tamara'"/>
            </field>
        </field>
    </record>

</odoo>
