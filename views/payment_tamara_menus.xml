<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Open the Tamara provider form directly. -->
    <record id="action_tamara_settings" model="ir.actions.act_window">
        <field name="name">Tamara Settings</field>
        <field name="res_model">payment.provider</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="payment_provider_tamara"/>
        <field name="target">current</field>
        <field name="context">{'create': False}</field>
    </record>

    <!-- Root app entry on the main admin menu. -->
    <menuitem id="menu_tamara_root"
              name="Tamara"
              sequence="65"
              web_icon="payment_tamara,static/description/icon.png"
              groups="base.group_system"/>

    <menuitem id="menu_tamara_settings"
              name="Settings"
              parent="menu_tamara_root"
              action="action_tamara_settings"
              sequence="10"
              groups="base.group_system"/>

    <!-- Shortcut under Website > Configuration > eCommerce. -->
    <menuitem id="menu_tamara_ecommerce_settings"
              name="Tamara"
              parent="website_sale.menu_ecommerce_settings"
              action="action_tamara_settings"
              sequence="15"
              groups="base.group_system"/>

</odoo>
